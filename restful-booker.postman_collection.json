    {
      "name": "01. POST /auth",
      "item": [
        {
          "name": "CreateToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Data Extraction\r",
                  "const scenarioName = pm.iterationData.get(\"scenario\");\r",
                  "const isSuccess = pm.iterationData.get(\"is_success\") === true || pm.iterationData.get(\"is_success\") === \"true\";\r",
                  "\r",
                  "// 2. Initial Assertion\r",
                  "pm.test(`[${scenarioName}] Status code is 200`, function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// 3. Guard Clause: Abort if status code is unexpected\r",
                  "if (pm.response.code !== 200) {\r",
                  "    console.warn(`[${scenarioName}] Unexpected status code. Aborting JSON parsing and assertions.`);\r",
                  "    return;\r",
                  "}\r",
                  "\r",
                  "// 4. Parse Response\r",
                  "const responseJson = pm.response.json();\r",
                  "\r",
                  "// 5. Dynamic Branching Assertions\r",
                  "if (isSuccess) {\r",
                  "    pm.test(`[${scenarioName}] Token is successfully retrieved`, function () {\r",
                  "        pm.expect(responseJson.token).to.not.be.undefined;\r",
                  "        pm.collectionVariables.set(\"token\", responseJson.token);\r",
                  "    });\r",
                  "} else {\r",
                  "    const expectedMsg = pm.iterationData.get(\"expected_error_msg\");\r",
                  "    pm.test(`[${scenarioName}] Error message matches expected value: ${expectedMsg}`, function () {\r",
                  "        pm.expect(responseJson.reason).to.eql(expectedMsg);\r",
                  "    });\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "disabledSystemHeaders": {}
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\" : \"{{username}}\",\r\n    \"password\" : \"{{password}}\"\r\n}",
              "options": {
